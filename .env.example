DB_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET_KEY=your_secret_key
JWT_ACCESS_TOKEN_EXPIRATION=your_access_token_expiration

MQTT_BROKER_URL=ssl://<MQTT_HOST>:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=your_client_id
EMQX_MANAGEMENT_BASE_URL=https://your-emqx-management-host:8443/api/v5
EMQX_API_KEY=your_emqx_api_key
EMQX_API_SECRET=your_emqx_api_secret
EMQX_AUTHENTICATOR_ID=password_based:built_in_database
MQTT_ENABLED=true